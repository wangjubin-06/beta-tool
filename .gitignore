```gitignore
# =========================
# Python
# =========================

__pycache__/
*.py[cod]
*$py.class

# Python build / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# =========================
# Testing / Coverage
# =========================

.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml

# =========================
# Type checking / Linters
# =========================

.mypy_cache/
.pyre/
.ruff_cache/

# =========================
# Jupyter
# =========================

.ipynb_checkpoints/

# =========================
# IDEs / Editors
# =========================

.vscode/
.idea/
*.swp
*.swo

# =========================
# OS files
# =========================

.DS_Store
Thumbs.db
Desktop.ini

# =========================
# Environment / Secrets
# =========================

.env
.env.*
!.env.example

# =========================
# Project-specific
# =========================

# Local data / downloaded market data
data/
*.csv
*.parquet
*.feather

# Generated reports / plots
reports/
outputs/
plots/

# Local configuration
config.local.*
```
